{
  "name": "mizu-pairrank",
  "version": "1.6.2",
  "description": "mizu-pairrank",
  "private": true,
  "type": "module",
  "author": "\u307f\u305a",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "check": "npm run notices:check && npm run lint && npm run format:check && npm run typecheck && npm run test:run && npm run build && npm run cargo:fmt && npm run cargo:clippy && npm run cargo:test",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "notices:check": "node --test scripts/third-party-notices.verify.mjs && node scripts/third-party-notices.mjs --check",
    "notices:generate": "node scripts/third-party-notices.mjs --write",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "pdfmake": "0.3.12",
    "unicode-segmenter": "0.17.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/pdfmake": "0.3.3",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pdf-lib": "1.17.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
