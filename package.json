{
  "name": "test-tauri-app",
  "version": "0.2.0",
  "description": "mizu-pairrank",
  "private": true,
  "type": "module",
  "author": "\u307f\u305a",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:run && npm run build && npm run cargo:fmt && npm run cargo:clippy && npm run cargo:test",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
